[Unit]
Description=Kernoryx power sessions and thermal monitoring
After=dbus.service

[Service]
Type=simple
ExecStart=@CMAKE_INSTALL_PREFIX@/sbin/kernoryxd
Restart=on-failure
RestartSec=2
StateDirectory=kernoryx
StateDirectoryMode=0700
RuntimeDirectory=kernoryx
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0077
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=full
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
